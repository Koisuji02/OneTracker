# Copy to android/keystore.properties and fill in, or the release build stays
# unsigned (debug builds are unaffected). Generate the key once with:
#
#   keytool -genkeypair -v -keystore android/keystore/onetracker-upload.jks \
#     -alias onetracker-upload -keyalg RSA -keysize 4096 -validity 10000
#
storeFile=keystore/onetracker-upload.jks
storePassword=
keyAlias=onetracker-upload
keyPassword=
