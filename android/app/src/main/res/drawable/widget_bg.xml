<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded widget surface. Solid WHITE on purpose: the provider tints it with
     the app theme's surface colour (setBackgroundTintList), so one drawable
     serves every theme while keeping the corners. Launchers that don't clip
     widgets themselves (HyperOS/MIUI) rely on this for the rounded look. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/white" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
