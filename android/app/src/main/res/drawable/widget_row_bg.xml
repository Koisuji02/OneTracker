<?xml version="1.0" encoding="utf-8"?>
<!-- Inner half of a row: the card itself, tinted with the theme's `card2` by
     the service. Radius is 1dp tighter than widget_row_border so the frame
     stays even all the way around the corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/white" />
    <corners android:radius="@dimen/widget_row_inner_radius" />
</shape>
